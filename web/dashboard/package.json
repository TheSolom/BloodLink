{
    "name": "bloodlink-dashboard",
    "version": "0.1.0",
    "private": true,
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "tsc -b && vite build",
        "preview": "vite preview",
        "typecheck": "tsc --noEmit",
        "lint": "oxlint",
        "lint:fix": "oxlint --fix",
        "format": "oxfmt --write",
        "format:check": "oxfmt --check",
        "check": "oxlint && oxfmt --check && tsc --noEmit",
        "fix": "oxlint --fix && oxfmt --write",
        "test": "vitest run",
        "test:watch": "vitest",
        "gen:api": "openapi-typescript openapi.json -o src/shared/api/generated/schema.d.ts"
    },
    "dependencies": {
        "@radix-ui/react-select": "^2.4.1",
        "@radix-ui/react-slot": "^1.5.0",
        "@tanstack/react-query": "^5.105.0",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "lucide-react": "^1.66.0",
        "react": "^19.3.1",
        "react-dom": "^19.3.1",
        "tailwind-merge": "^3.7.0",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@tailwindcss/vite": "^4.3.3",
        "@tanstack/eslint-plugin-query": "^5.106.1",
        "@testing-library/dom": "^10.4.2",
        "@testing-library/jest-dom": "^7.0.1",
        "@testing-library/react": "^16.3.3",
        "@testing-library/user-event": "^14.6.8",
        "@types/node": "^26.6.6",
        "@types/react": "^19.3.0",
        "@types/react-dom": "^19.3.0",
        "@vitejs/plugin-react": "^6.1.2",
        "eslint-plugin-sonarjs": "^4.2.2",
        "jsdom": "^30.1.3",
        "msw": "^3.0.3",
        "openapi-typescript": "^7.13.0",
        "oxfmt": "0.77.0",
        "oxlint": "1.92.0",
        "tailwindcss": "^4.3.3",
        "typescript": "~5.9.3",
        "vite": "^8.3.5",
        "vitest": "^5.0.5"
    },
    "engines": {
        "node": "^22.22.2 || ^24.15.0 || >=26.0.0"
    }
}
