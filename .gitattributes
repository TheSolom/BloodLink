# Set default behavior to automatically detect text files and normalize line endings
* text=auto

# Explicit text files with LF line endings
*.sh text eol=lf
*.bash text eol=lf

# C# and .NET project files
*.cs text diff=csharp
*.sln text eol=crlf
*.slnx text
*.csproj text
*.props text
*.targets text

# Configuration and documentation
*.json text
*.yaml text
*.yml text
*.md text
*.editorconfig text
*.gitignore text
*.gitattributes text

# Binary files
*.dll binary
*.exe binary
*.pdb binary
*.nupkg binary
*.snupkg binary
*.png binary
*.jpg binary
*.jpeg binary
*.ico binary
